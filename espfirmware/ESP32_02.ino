static constexpr uint8_t BROADCAST_MAC[6] = {0xFF,0xFF,0xFF,0xFF,0xFF,0xFF};
static bool addPeer(const uint8_t *mac) {
  if (esp_now_is_peer_exist(mac)) return true;
  esp_now_peer_info_t peer{};
  memcpy(peer.peer_addr, mac, 6);
  peer.channel = 0;
  peer.ifidx = WIFI_IF_STA;
  peer.encrypt = false;
  return esp_now_add_peer(&peer) == ESP_OK;
}
static bool sendBroadcast(const MeshPacket &packet) {
  return esp_now_send(BROADCAST_MAC, reinterpret_cast<const uint8_t *>(&packet), sizeof(packet)) == ESP_OK;
}
static void copyText(char *dst, size_t size, const char *src) {
  strncpy(dst, src, size - 1);
  dst[size - 1] = '\0';
}

static bool isChannelSyncType(uint8_t type) {
  return type >= PACKET_GATEWAY_BEACON && type <= PACKET_CHANNEL_CHANGE_NOTICE;
}
static bool validChannelSyncPacket(const MeshPacket &p) {
  return p.version == PROTOCOL_VERSION && isChannelSyncType(p.type) &&
    !strncmp(p.project_id, PROJECT_ID, sizeof(p.project_id)) &&
    !strncmp(p.network_id, NETWORK_ID, sizeof(p.network_id)) &&
    !strncmp(p.experiment_id, EXPERIMENT_ID, sizeof(p.experiment_id)) &&
    p.routing_algorithm == SYNC_MARKER && p.feature_valid == 0xA5 &&
    p.predicted_class == -42 && p.route_change == SYNC_ROUTE_MARKER &&
    p.route_change_reason == 0x51 && p.hop_count == 0x5A && p.hop_limit == 0xA5 &&
    p.source_packets_sent == SYNC_MAGIC && p.next_hop_id >= 1 && p.next_hop_id <= 13 &&
    p.selected_next_hop_id == p.next_hop_id;
}
static MeshPacket makeChannelSyncPacket(uint8_t type, uint8_t source, uint8_t destination,
                                        uint8_t channel, uint32_t sequence, uint32_t uptime) {
  MeshPacket p{}; p.version=PROTOCOL_VERSION; p.type=type;
  copyText(p.project_id,sizeof(p.project_id),PROJECT_ID);
  copyText(p.network_id,sizeof(p.network_id),NETWORK_ID);
  copyText(p.experiment_id,sizeof(p.experiment_id),EXPERIMENT_ID);
  p.source_id=source; p.destination_id=destination; p.next_hop_id=channel;
  p.selected_next_hop_id=channel; p.routing_algorithm=SYNC_MARKER; p.sequence=sequence;
  p.source_uptime_ms=uptime; p.hop_count=0x5A; p.hop_limit=0xA5;
  p.feature_valid=0xA5; p.predicted_class=-42; p.route_change=SYNC_ROUTE_MARKER;
  p.route_change_reason=0x51; p.source_packets_sent=SYNC_MAGIC; return p;
}
static bool sendChannelSyncPacket(const uint8_t *mac, const MeshPacket &p) {
  return addPeer(mac) && esp_now_send(mac,reinterpret_cast<const uint8_t*>(&p),sizeof(p))==ESP_OK;
}
static void configureChannelScanRange() {
  wifi_country_t country{};
  scanCountryAvailable=esp_wifi_get_country(&country)==ESP_OK&&country.nchan;
  if (scanCountryAvailable) {
    scanFirstChannel=country.schan;
    scanLastChannel=(uint8_t)min(13,(int)country.schan+(int)country.nchan-1);
  } else { scanFirstChannel=1; scanLastChannel=11; }
  if (scanFirstChannel<1 || scanFirstChannel>13 || scanFirstChannel>scanLastChannel) {
    scanFirstChannel=1; scanLastChannel=11;
  }
  scanChannel=scanFirstChannel;
  Serial.printf("CHANNEL_SCAN_RANGE first=%u last=%u regulatory_source=%s\n",scanFirstChannel,scanLastChannel,scanCountryAvailable?"configured":"world_safe_fallback");
}
static void startChannelScan(const char *reason) {
  meshChannel=scanChannel; channelState=CHANNEL_STATE_SCAN; syncRetries=0;
  scanDwellAt=0; scanPauseAt=millis(); lastGatewayBeaconAt=0;
  Serial.printf("MESH_DISCOVERY_START node=%u channel=%u reason=%s\n",NODE_ID,meshChannel,reason);
}
static bool processChannelSyncFrame(const RxFrame &frame) {
  const MeshPacket &p=frame.packet;
  if (!isChannelSyncType(p.type)) return false;
  if (!validChannelSyncPacket(p) || p.source_id!=GATEWAY_ID ||
      (p.destination_id!=NODE_ID && p.destination_id!=255)) return true;
  uint8_t radioChannel=0; wifi_second_chan_t second;
  if (esp_wifi_get_channel(&radioChannel,&second)!=ESP_OK || radioChannel!=p.next_hop_id) return true;
  if (p.type==PACKET_GATEWAY_BEACON || p.type==PACKET_CHANNEL_CHANGE_NOTICE) {
    lastGatewayBeaconAt=millis();
    if (channelState==CHANNEL_STATE_SYNCED) return true;
    if (channelState==CHANNEL_STATE_SCAN) {
      memcpy(gatewayMac,frame.mac,sizeof(gatewayMac)); meshChannel=p.next_hop_id;
      channelState=CHANNEL_STATE_WAIT; syncRetries=0; syncRequestAt=0;
      Serial.printf("CHANNEL_BEACON_FOUND node=%u channel=%u\n",NODE_ID,meshChannel);
    }
    return true;
  }
  if (p.type==PACKET_CHANNEL_SYNC_RESPONSE && p.destination_id==NODE_ID &&
      channelState==CHANNEL_STATE_WAIT && p.sequence==syncSequence && p.source_uptime_ms==syncNonceUptime &&
      memcmp(frame.mac,gatewayMac,sizeof(gatewayMac))==0) {
    channelState=CHANNEL_STATE_SYNCED; meshChannel=p.next_hop_id;
    lastGatewayBeaconAt=millis(); syncRetries=0; lastSyncAckAt=millis();
    MeshPacket ack=makeChannelSyncPacket(PACKET_CHANNEL_SYNC_ACK,NODE_ID,GATEWAY_ID,meshChannel,syncSequence,syncNonceUptime);
    sendChannelSyncPacket(gatewayMac,ack);
    Serial.printf("NODE_CHANNEL_SYNC node=%u channel=%u result=success\n",NODE_ID,meshChannel);
    return true;
  }
  return true;
}
static void serviceChannelSync() {
  uint32_t now=millis();
  if (channelState==CHANNEL_STATE_SYNCED && now-lastGatewayBeaconAt>CHANNEL_BEACON_TIMEOUT_MS) {
    Serial.printf("CHANNEL_SYNC_LOST node=%u channel=%u age_ms=%lu reason=beacon_timeout\n",NODE_ID,meshChannel,(unsigned long)(now-lastGatewayBeaconAt));
    startChannelScan("gateway_beacon_timeout");
  }
  if (channelState==CHANNEL_STATE_SYNCED) {
    if (now-lastSyncAckAt>=5000UL) {
      MeshPacket ack=makeChannelSyncPacket(PACKET_CHANNEL_SYNC_ACK,NODE_ID,GATEWAY_ID,meshChannel,syncSequence,syncNonceUptime);
      if (sendChannelSyncPacket(gatewayMac,ack)) lastSyncAckAt=now;
    }
    return;
  }
  if (channelState==CHANNEL_STATE_WAIT) {
    if (now-syncRequestAt>=CHANNEL_SYNC_RETRY_MS) {
      if (syncRetries>=CHANNEL_SYNC_MAX_RETRIES) {
        Serial.printf("CHANNEL_SYNC_FAILED node=%u channel=%u retries=%u reason=response_timeout\n",NODE_ID,meshChannel,syncRetries);
        channelState=CHANNEL_STATE_SCAN; scanDwellAt=now; scanChannel=(meshChannel>=scanLastChannel)?scanFirstChannel:(uint8_t)(meshChannel+1);
        scanPauseAt=now+CHANNEL_SCAN_PAUSE_MS; return;
      }
      ++syncRetries; ++syncSequence; syncNonceUptime=now;
      MeshPacket request=makeChannelSyncPacket(PACKET_CHANNEL_SYNC_REQUEST,NODE_ID,GATEWAY_ID,meshChannel,syncSequence,syncNonceUptime);
      if (!sendChannelSyncPacket(gatewayMac,request)) Serial.printf("CHANNEL_SYNC_RETRY node=%u channel=%u retry=%u reason=send_failed\n",NODE_ID,meshChannel,syncRetries);
      syncRequestAt=now;
    }
    return;
  }
  if (now<scanPauseAt) return;
  if (!scanDwellAt || now-scanDwellAt>=CHANNEL_SCAN_DWELL_MS) {
    uint8_t attempts=0; esp_err_t err=ESP_FAIL;
    while (attempts++<=scanLastChannel-scanFirstChannel) {
      err=esp_wifi_set_channel(scanChannel,WIFI_SECOND_CHAN_NONE);
      if (err==ESP_OK) break;
      scanChannel=(scanChannel>=scanLastChannel)?scanFirstChannel:(uint8_t)(scanChannel+1);
    }
    if (err!=ESP_OK) { Serial.printf("CHANNEL_SCAN_BLOCKED node=%u reason=no_permitted_channels\n",NODE_ID); scanPauseAt=now+1000UL; return; }
    meshChannel=scanChannel; scanDwellAt=now;
    Serial.printf("CHANNEL_SCAN node=%u channel=%u\n",NODE_ID,meshChannel);
    if(scanChannel>=scanLastChannel){
      scanChannel=scanFirstChannel;scanPauseAt=now+CHANNEL_SCAN_PAUSE_MS;
      Serial.printf("CHANNEL_SCAN_CYCLE_COMPLETE node=%u next_scan_after_ms=%lu\n",NODE_ID,(unsigned long)CHANNEL_SCAN_PAUSE_MS);
    }else scanChannel=(uint8_t)(scanChannel+1);
  }
}

