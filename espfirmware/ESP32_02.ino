static void requestStatusLED(uint8_t color,uint32_t holdMs){
  uint32_t until=millis()+holdMs;
  if(color==LED_COLOR_RED)ledRedUntil=until;
  else if(color==LED_COLOR_YELLOW)ledYellowUntil=until;
  else if(color==LED_COLOR_GREEN)ledGreenUntil=until;
}
static void serviceStatusLED(bool errorActive,bool processingActive){
  uint32_t now=millis();
  bool red=errorActive||(int32_t)(ledRedUntil-now)>0;
  bool yellow=!red&&(processingActive||(int32_t)(ledYellowUntil-now)>0);
  bool green=!red&&!yellow&&(int32_t)(ledGreenUntil-now)>0;
  if(red!=ledRedOn)digitalWrite(LED_RED,red?HIGH:LOW);
  if(yellow!=ledYellowOn)digitalWrite(LED_YELLOW,yellow?HIGH:LOW);
  if(green!=ledGreenOn)digitalWrite(LED_GREEN,green?HIGH:LOW);
  ledRedOn=red;ledYellowOn=yellow;ledGreenOn=green;
}
#if ESP_ARDUINO_VERSION_MAJOR >= 3
static void receiveCallback(const esp_now_recv_info_t *info,const uint8_t *data,int len) {
  if(!info||len!=sizeof(MeshPacket))return;
  RxFrame f{}; memcpy(f.mac,info->src_addr,6); memcpy(&f.packet,data,sizeof(MeshPacket));
  f.rssi=info->rx_ctrl?info->rx_ctrl->rssi:UNKNOWN_I16; xQueueSend(rxQueue,&f,0);
}
static void sendCallback(const wifi_tx_info_t *,esp_now_send_status_t s){macSendFailed=s!=ESP_NOW_SEND_SUCCESS;}
#else
static void receiveCallback(const uint8_t *mac,const uint8_t *data,int len) {
  if(len!=sizeof(MeshPacket))return;
  RxFrame f{}; memcpy(f.mac,mac,6); memcpy(&f.packet,data,sizeof(MeshPacket)); f.rssi=UNKNOWN_I16; xQueueSend(rxQueue,&f,0);
}
static void sendCallback(const uint8_t *,esp_now_send_status_t s){macSendFailed=s!=ESP_NOW_SEND_SUCCESS;}
