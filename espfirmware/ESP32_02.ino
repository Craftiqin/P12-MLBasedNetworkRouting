static void remember(const MeshPacket&p){seen[seenCursor]={p.source_id,p.sequence,p.source_uptime_ms};seenCursor=(seenCursor+1)%SEEN_SIZE;}
static bool seenBefore(const MeshPacket&p){for(const auto&k:seen)if(k.source==p.source_id&&k.sequence==p.sequence&&k.uptime==p.source_uptime_ms)return true;return false;}
static void updateNeighbor(const uint8_t*mac,int16_t rssi){
  lastRssi=rssi;
  int slot=-1,oldest=0;uint32_t oldestTime=UINT32_MAX;
  for(int i=0;i<8;i++){if(neighbors[i].packets&&memcmp(neighbors[i].mac,mac,6)==0){slot=i;break;}if(!neighbors[i].packets){oldest=i;oldestTime=0;}else if(oldestTime&&neighbors[i].heard<oldestTime){oldest=i;oldestTime=neighbors[i].heard;}}
  if(slot<0)slot=oldest;
  if(!neighbors[slot].packets||memcmp(neighbors[slot].mac,mac,6)!=0){memcpy(neighbors[slot].mac,mac,6);neighbors[slot].packets=0;}
  neighbors[slot].rssi=rssi;neighbors[slot].heard=millis();++neighbors[slot].packets;
}
static void refreshGatewayWindow(uint32_t now){
  if(!gatewayWindowStarted||now-gatewayWindowStarted>=GATEWAY_PROBE_WINDOW){
    gatewayWindowStarted=now;gatewayProbeAttempts=gatewayProbeSuccesses=0;gatewayLatencyTotal=0;
    gatewayLatencyMs=UNKNOWN_U16;
  }
}
static bool gatewayPathAvailable(uint32_t now){
  return gatewayProbeAttempts>=PATH_MIN_SAMPLES&&gatewayProbeSuccesses>0&&
         lastGatewaySuccess&&now-lastGatewaySuccess<=PATH_STATUS_MAX_AGE;
}
static uint8_t gatewayPathLoss(){
  return gatewayProbeAttempts>=PATH_MIN_SAMPLES
    ? (uint8_t)(100U-((uint32_t)gatewayProbeSuccesses*100U/gatewayProbeAttempts)) : 255;
}
static void sendPathStatus(const RxFrame&f){
  if(waitingAck||waitingGatewayProbe)return;
  const MeshPacket&request=f.packet;uint32_t now=millis();
  MeshPacket status{};status.version=PROTOCOL_VERSION;status.type=PACKET_PATH_STATUS;
  copyText(status.project_id,sizeof(status.project_id),PROJECT_ID);copyText(status.network_id,sizeof(status.network_id),NETWORK_ID);
  copyText(status.experiment_id,sizeof(status.experiment_id),EXPERIMENT_ID);
  status.source_id=NODE_ID;status.destination_id=1;status.next_hop_id=1;status.forwarding_node_id=NODE_ID;
  status.sequence=request.sequence;status.source_uptime_ms=request.source_uptime_ms;
  // Keep last measured hop count/latency while explicitly reporting current availability.
  status.hop_count=gatewayPathHops?(uint8_t)(1+gatewayPathHops):0;
  // PATH_STATUS feature_valid: 1=up, 0=measured down, 255=not enough probes.
  status.feature_valid=gatewayPathAvailable(now)?1:(gatewayProbeAttempts>=PATH_MIN_SAMPLES?0:255);status.last_hop_rssi_dbm=gatewayRssi;
  status.latency_ms=gatewayLatencyMs;status.packet_loss_percent=gatewayPathLoss();
  if(addPeer(f.mac))esp_now_send(f.mac,reinterpret_cast<const uint8_t*>(&status),sizeof(status));
}
static bool serviceGatewayProbe(){
  if (channelState != CHANNEL_STATE_SYNCED) return false;
  uint32_t now=millis();refreshGatewayWindow(now);
  if(waitingGatewayProbe){
    if(now-gatewayProbeAt<GATEWAY_PROBE_TIMEOUT)return true;
    waitingGatewayProbe=false;
  }
  if(qCount||waitingAck||now-lastGatewayProbe<GATEWAY_PROBE_INTERVAL)return false;
  MeshPacket probe{};probe.version=PROTOCOL_VERSION;probe.type=PACKET_GATEWAY_PROBE;
  copyText(probe.project_id,sizeof(probe.project_id),PROJECT_ID);copyText(probe.network_id,sizeof(probe.network_id),NETWORK_ID);
  copyText(probe.experiment_id,sizeof(probe.experiment_id),EXPERIMENT_ID);
  probe.source_id=NODE_ID;probe.destination_id=GATEWAY_ID;probe.next_hop_id=GATEWAY_ID;
  probe.forwarding_node_id=NODE_ID;probe.sequence=++gatewayProbeSequence;probe.source_uptime_ms=now;probe.hop_limit=MAX_HOPS;
  if(gatewayProbeAttempts<UINT16_MAX)++gatewayProbeAttempts;
  waitingGatewayProbe=true;gatewayProbeAt=lastGatewayProbe=now;
  if(!sendBroadcast(probe))gatewayProbeAt=now-GATEWAY_PROBE_TIMEOUT;
  return true;
}
static const char *routingModeName(uint8_t mode){
  return mode==ROUTING_ML_UPPER||mode==ROUTING_ML_LOWER?"ML_SELECTED":"BASELINE_FALLBACK";
}
static void sendAck(const uint8_t*mac,uint8_t previous,uint32_t seq,uint32_t uptime){
  MeshPacket a{};a.version=PROTOCOL_VERSION;a.type=PACKET_ACK;
  copyText(a.project_id,sizeof(a.project_id),PROJECT_ID);copyText(a.network_id,sizeof(a.network_id),NETWORK_ID);copyText(a.experiment_id,sizeof(a.experiment_id),EXPERIMENT_ID);
  a.source_id=NODE_ID;a.destination_id=previous;a.next_hop_id=previous;a.forwarding_node_id=NODE_ID;a.sequence=seq;a.source_uptime_ms=uptime;
  if(addPeer(mac))esp_now_send(mac,reinterpret_cast<const uint8_t*>(&a),sizeof(a));
}
static bool enqueue(const MeshPacket&p){if(qCount>=FORWARD_QUEUE_SIZE)return false;forwardQueue[qTail]=p;qTail=(qTail+1)%FORWARD_QUEUE_SIZE;++qCount;return true;}
static void processFrame(const RxFrame&f){
  const MeshPacket&p=f.packet;
  if(p.version!=PROTOCOL_VERSION||strncmp(p.project_id,PROJECT_ID,sizeof(p.project_id))||strncmp(p.network_id,NETWORK_ID,sizeof(p.network_id))||strncmp(p.experiment_id,EXPERIMENT_ID,sizeof(p.experiment_id)))return;
  if (isChannelSyncType(p.type)) { processChannelSyncFrame(f); return; }
  if (channelState != CHANNEL_STATE_SYNCED) return;
  requestStatusLED(LED_COLOR_GREEN,LED_SUCCESS_HOLD_MS);
  updateNeighbor(f.mac,f.rssi);
  if(p.type==PACKET_DELIVERY_REPORT&&p.source_id==GATEWAY_ID&&p.destination_id==1&&p.next_hop_id==1&&p.forwarding_node_id==NODE_ID){
    MeshPacket report=p;report.forwarding_node_id=NODE_ID;
    bool sent=sendBroadcast(report);
    Serial.printf("DELIVERY_REPORT_RELAY seq=%lu relay=%u tx=%s result=%s\n",(unsigned long)p.sequence,NODE_ID,sent?"queued":"failed",sent?"forwarded":"unconfirmed");
    return;
  }
  if(p.type==PACKET_GATEWAY_PROBE_ACK){
    if(waitingGatewayProbe&&p.source_id==GATEWAY_ID&&p.destination_id==NODE_ID&&p.sequence==gatewayProbeSequence&&p.source_uptime_ms==gatewayProbeAt){
      uint32_t rtt=millis()-gatewayProbeAt;waitingGatewayProbe=false;++gatewayProbeSuccesses;lastGatewaySuccess=millis();gatewayRssi=f.rssi;gatewayPathHops=p.hop_count;
      gatewayLatencyTotal+=rtt;gatewayLatencyMs=(uint16_t)min((uint32_t)UINT16_MAX,gatewayLatencyTotal/gatewayProbeSuccesses);
    }return;
  }
  if(p.type==PACKET_PATH_PROBE&&p.source_id==1&&p.destination_id==GATEWAY_ID){sendPathStatus(f);return;}
  if(p.type==PACKET_ACK){
    if(waitingAck&&p.source_id==GATEWAY_ID&&p.next_hop_id==NODE_ID&&p.sequence==inFlight.sequence&&p.source_uptime_ms==inFlight.source_uptime_ms){
      lastAckRtt=millis()-lastSend;++acked;++forwarded;qHead=(qHead+1)%FORWARD_QUEUE_SIZE;--qCount;waitingAck=false;txAttempts=0;
      requestStatusLED(LED_COLOR_GREEN,LED_SUCCESS_HOLD_MS);
      Serial.printf("FORWARD_ACK uptime=%lu source=1 relay=%u seq=%lu mode=%s result=forwarded ack=yes rtt_ms=%lu hop_count=%u\n",
        (unsigned long)millis(),NODE_ID,(unsigned long)p.sequence,
        inFlight.routing_algorithm==ROUTING_ML_UPPER||inFlight.routing_algorithm==ROUTING_ML_LOWER?"ML_ACTIVE":"BASELINE_FALLBACK",
        (unsigned long)lastAckRtt,inFlight.hop_count);
    }return;
  }
  if(p.type!=PACKET_DATA||p.next_hop_id!=NODE_ID||p.destination_id!=GATEWAY_ID||p.source_id==NODE_ID||p.hop_count>=p.hop_limit)return;
  if(!gatewayPathAvailable(millis())){requestStatusLED(LED_COLOR_RED,LED_ERROR_HOLD_MS);Serial.printf("DROP reason=gateway_path_unavailable seq=%lu\n",(unsigned long)p.sequence);return;}
  ++rxCount;
  if(seenBefore(p)){++duplicates;sendAck(f.mac,p.forwarding_node_id,p.sequence,p.source_uptime_ms);return;}
  if(qCount>=FORWARD_QUEUE_SIZE){requestStatusLED(LED_COLOR_RED,LED_ERROR_HOLD_MS);Serial.println("DROP reason=forward_queue_full");return;}
  MeshPacket forwardedPacket=p;forwardedPacket.last_hop_rssi_dbm=f.rssi;
  ++forwardedPacket.hop_count;forwardedPacket.forwarding_node_id=NODE_ID;forwardedPacket.next_hop_id=GATEWAY_ID;
  if(!enqueue(forwardedPacket))return;
  remember(p);sendAck(f.mac,p.forwarding_node_id,p.sequence,p.source_uptime_ms);
  Serial.printf("RECEIVED uptime=%lu current=%u source=%u selected_relay=%u seq=%lu mode=%s rssi=%d queued=yes\n",
    (unsigned long)millis(),NODE_ID,p.source_id,NODE_ID,(unsigned long)p.sequence,routingModeName(p.routing_algorithm),f.rssi);
}
static void serviceReceive(){RxFrame f{};while(xQueueReceive(rxQueue,&f,0)==pdTRUE)processFrame(f);}
static void serviceForward(){
  if(channelState!=CHANNEL_STATE_SYNCED||!qCount)return;
  if(!waitingAck){inFlight=forwardQueue[qHead];
    requestStatusLED(LED_COLOR_YELLOW,LED_ACTIVITY_HOLD_MS);
    txAttempts=1;++txCount;macSendFailed=false;
    if(sendBroadcast(inFlight)){lastSend=millis();waitingAck=true;
      Serial.printf("FORWARD_TX uptime=%lu current=%u source=%u seq=%lu source_relay=%u mode=%s tx=queued ack=pending hop_count=%u\n",
        (unsigned long)lastSend,NODE_ID,inFlight.source_id,(unsigned long)inFlight.sequence,NODE_ID,
        routingModeName(inFlight.routing_algorithm),inFlight.hop_count);
    }else{macSendFailed=true;lastSend=millis();waitingAck=true;
      Serial.printf("FORWARD_TX uptime=%lu current=%u source=%u seq=%lu mode=%s tx=local_error ack=pending hop_count=%u\n",
        (unsigned long)lastSend,NODE_ID,inFlight.source_id,(unsigned long)inFlight.sequence,routingModeName(inFlight.routing_algorithm),inFlight.hop_count);
    }return;
  }
  if(!macSendFailed&&millis()-lastSend<ACK_TIMEOUT_MS)return;
  if(txAttempts<MAX_TRANSMISSIONS){++txAttempts;++retries;macSendFailed=false;requestStatusLED(LED_COLOR_YELLOW,LED_ACTIVITY_HOLD_MS);
    if(sendBroadcast(inFlight)){lastSend=millis();}else{macSendFailed=true;lastSend=millis();}return;}
  ++failed;++txFailed;Serial.printf("FORWARD_FAILED uptime=%lu source=%u relay=%u seq=%lu mode=%s tx=failed ack=no attempts=%u hop_count=%u\n",
    (unsigned long)millis(),inFlight.source_id,NODE_ID,(unsigned long)inFlight.sequence,routingModeName(inFlight.routing_algorithm),txAttempts,inFlight.hop_count);
  requestStatusLED(LED_COLOR_RED,LED_ERROR_HOLD_MS);
  qHead=(qHead+1)%FORWARD_QUEUE_SIZE;--qCount;waitingAck=false;txAttempts=0;
}
void setup(){
  Serial.begin(115200);WiFi.mode(WIFI_STA);WiFi.setSleep(false);esp_wifi_set_channel(MESH_BOOT_CHANNEL,WIFI_SECOND_CHAN_NONE);configureChannelScanRange();
  pinMode(LED_RED,OUTPUT);pinMode(LED_YELLOW,OUTPUT);pinMode(LED_GREEN,OUTPUT);
  digitalWrite(LED_RED,LOW);digitalWrite(LED_YELLOW,LOW);digitalWrite(LED_GREEN,LOW);
  rxQueue=xQueueCreate(16,sizeof(RxFrame));if(!rxQueue){Serial.println("ERROR rx_queue");while(true)delay(1000);}
  if(esp_now_init()!=ESP_OK){Serial.println("ERROR esp_now_init");while(true)delay(1000);}
  addPeer(BROADCAST_MAC);esp_now_register_recv_cb(receiveCallback);
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  esp_now_register_send_cb(sendCallback);
#else
  esp_now_register_send_cb(sendCallback);
#endif
  startChannelScan("boot");
  Serial.printf("READY ESP32_02 channel=%u mac=%s next_hop=%u mesh=discovering\n",meshChannel,WiFi.macAddress().c_str(),GATEWAY_ID);
}
void loop(){
  serviceChannelSync();
  serviceReceive();
  if(!serviceGatewayProbe())serviceForward();
  if(millis()-lastStats>=10000){lastStats=millis();uint8_t active=0;for(auto&n:neighbors)if(n.packets)++active;
    Serial.printf("LINK_STATS node=%u neighbors=%u rx=%lu forwarded=%lu acked=%lu duplicate=%lu retry=%lu failed=%lu loss_pct=%lu last_rssi=%d latency_ms=%lu\n",
      NODE_ID,active,(unsigned long)rxCount,(unsigned long)forwarded,(unsigned long)acked,(unsigned long)duplicates,(unsigned long)retries,(unsigned long)failed,
      (unsigned long)(txCount?min(100UL,txFailed*100UL/txCount):0),lastRssi,(unsigned long)lastAckRtt);
  }
  serviceStatusLED(channelState!=CHANNEL_STATE_SYNCED||!gatewayPathAvailable(millis()),qCount>0||waitingAck||waitingGatewayProbe);
  delay(1);
}
