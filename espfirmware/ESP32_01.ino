static bool sendPacket() {
  macSendFailed = false;
  return sendBroadcast(currentPacket);
}
static void sendRoutingControlResult(const RoutingControlRx &rx, uint8_t result) {
  RoutingControlFrame response{}; response.magic=ROUTING_CONTROL_MAGIC; response.version=ROUTING_CONTROL_VERSION;
  response.kind=ROUTING_CONTROL_RESULT; response.source_id=NODE_ID; response.destination_id=GATEWAY_ID;
  response.epoch=rx.frame.epoch; response.command_sequence=rx.frame.command_sequence;
  response.evidence_sequence=rx.frame.evidence_sequence; response.expected_next_hop=selectedRelay;
  response.requested_next_hop=rx.frame.requested_next_hop; response.result=result;
  if (addPeer(rx.mac)) esp_now_send(rx.mac,reinterpret_cast<const uint8_t*>(&response),sizeof(response));
}
static void processRoutingControl(const RoutingControlRx &rx) {
  const RoutingControlFrame &f=rx.frame;
  if (channelState!=CHANNEL_STATE_SYNCED || memcmp(rx.mac,gatewayMac,6)!=0 ||
      f.source_id!=GATEWAY_ID || f.magic!=ROUTING_CONTROL_MAGIC || f.version!=ROUTING_CONTROL_VERSION) return;
  if (f.kind==ROUTING_CONTROL_STATE) {
    if (f.epoch<routingControlEpoch || f.enabled>1 || f.ttl_ms==0 || f.ttl_ms>ROUTING_COMMAND_MAX_TTL_MS) return;
    routingControlEpoch=f.epoch; pythonOwnsRoute=f.enabled==1;
    ownershipLeaseMs=f.ttl_ms; lastOwnershipFrameAt=millis();
    routingPrefs.putUInt("epoch",routingControlEpoch);
    Serial.printf("ROUTE_OWNER owner=%s epoch=%lu lease_ms=%lu result=accepted\n",
      pythonOwnsRoute?"PYTHON":"FIRMWARE",(unsigned long)routingControlEpoch,(unsigned long)ownershipLeaseMs);
    sendRoutingControlResult(rx,ROUTING_RESULT_APPLIED); return;
  }
  if (f.kind!=ROUTING_CONTROL_COMMAND) return;
  if (f.command_sequence==lastPythonCommandSequence) {
    sendRoutingControlResult(rx,lastPythonCommandResult); return;
  }
  uint8_t result=ROUTING_RESULT_REJECTED;
  if (!pythonOwnsRoute || f.epoch!=routingControlEpoch || f.command_sequence<lastPythonCommandSequence) {
    result=ROUTING_RESULT_REJECTED;
  } else if (!f.ttl_ms || f.ttl_ms>ROUTING_COMMAND_MAX_TTL_MS || millis()-rx.received_at_ms>=f.ttl_ms) {
    result=ROUTING_RESULT_EXPIRED;
  } else if (waitingForAck || f.expected_next_hop!=selectedRelay ||
             (f.requested_next_hop!=2 && f.requested_next_hop!=3)) {
    result=ROUTING_RESULT_REJECTED;
  } else if (f.requested_next_hop==selectedRelay) {
    result=ROUTING_RESULT_NO_CHANGE;
  } else {
    const CandidatePath &candidate=candidateFor(f.requested_next_hop);
    if (candidate.gatewayAvailabilityKnown && candidate.gatewayAvailable && pathStatusFresh(candidate,millis()) &&
        candidate.attempts>=PATH_MIN_SAMPLES && candidate.responses>0 && candidate.pathHops>0 &&
        candidate.pathHops<MAX_HOPS) {
      selectedRelay=f.requested_next_hop; lastRouteChange=millis(); lastRouteChangeReason="python_autonomous_command";
      currentDecision.nextHop=selectedRelay; currentDecision.mode=selectedRelay==2?ROUTING_ML_UPPER:ROUTING_ML_LOWER;
      currentDecision.reason="python_autonomous_command"; result=ROUTING_RESULT_APPLIED;
    }
  }
  if (f.command_sequence>lastPythonCommandSequence) {
    lastPythonCommandSequence=f.command_sequence; lastPythonCommandResult=result;
    routingPrefs.putUInt("command",lastPythonCommandSequence);
    routingPrefs.putUChar("result",lastPythonCommandResult);
  }
  Serial.printf("ROUTE_COMMAND seq=%lu epoch=%lu expected=%u requested=%u result=%u active=%u\n",
    (unsigned long)f.command_sequence,(unsigned long)f.epoch,f.expected_next_hop,f.requested_next_hop,result,selectedRelay);
  sendRoutingControlResult(rx,result);
}
static void serviceRoutingControl() {
  if (pythonOwnsRoute && ownershipLeaseMs && millis()-lastOwnershipFrameAt>ownershipLeaseMs) {
    pythonOwnsRoute=false; ownershipLeaseMs=0;
    Serial.printf("ROUTE_OWNER owner=FIRMWARE epoch=%lu reason=lease_expired fallback=embedded_decision_tree\n",
      (unsigned long)routingControlEpoch);
  }
  if (waitingForAck || !routingControlQueue) return;
  RoutingControlRx rx{};
  if (xQueueReceive(routingControlQueue,&rx,0)==pdTRUE) processRoutingControl(rx);
}
static void makePacket(const RouteDecision &decision) {
  memset(&currentPacket, 0, sizeof(currentPacket));
  currentPacket.version = PROTOCOL_VERSION;
  currentPacket.type = PACKET_DATA;
  copyText(currentPacket.project_id, sizeof(currentPacket.project_id), PROJECT_ID);
  copyText(currentPacket.network_id, sizeof(currentPacket.network_id), NETWORK_ID);
  copyText(currentPacket.experiment_id, sizeof(currentPacket.experiment_id), EXPERIMENT_ID);
  currentPacket.source_id = NODE_ID;
  currentPacket.destination_id = GATEWAY_ID;
  currentPacket.next_hop_id = decision.nextHop;
  currentPacket.forwarding_node_id = NODE_ID;
  currentPacket.routing_algorithm = decision.mode;
  currentPacket.sequence = sequenceNumber++;
  currentPacket.source_uptime_ms = millis();
  currentPacket.hop_limit = MAX_HOPS;
  currentPacket.temperature_centi_c = dhtValid ? lroundf(temperature * 100.0f) : UNKNOWN_I16;
  currentPacket.humidity_centi_percent = dhtValid ? lroundf(humidity * 100.0f) : UNKNOWN_U16;
  currentPacket.light_status = lightStatus ? 1 : 0;
  currentPacket.sound_detected = soundStatus ? 1 : 0;
  currentPacket.last_hop_rssi_dbm = lastAckRssi;
  double measuredPdr = 0.0, measuredLatencyMs = 0.0;
  const CandidatePath &path = candidateFor(decision.nextHop);
  if (candidateMetricsAvailable(path, millis(), measuredPdr, measuredLatencyMs)) {
    currentPacket.latency_ms = (uint16_t)min((double)UINT16_MAX, round(measuredLatencyMs));
    currentPacket.packet_loss_percent = (uint8_t)min(100.0, round((1.0 - measuredPdr) * 100.0));
  } else {
    currentPacket.latency_ms = UNKNOWN_U16;
    currentPacket.packet_loss_percent = 255;
  }
  currentPacket.throughput_bps = measuredThroughputBps;
  currentPacket.selected_next_hop_id = decision.nextHop;
  currentPacket.feature_valid = decision.featuresValid ? 1 : 0;
  currentPacket.predicted_class = decision.featuresValid ? (int8_t)decision.prediction : -99;
  currentPacket.source_packets_sent = sentPackets + 1;
  currentPacket.route_change_reason =
    !strcmp(decision.reason, "model_class_upper") ? 1 :
    !strcmp(decision.reason, "model_class_lower") ? 2 :
    !strcmp(decision.reason, "required_candidate_metrics_missing_or_stale") ? 3 :
    !strcmp(decision.reason, "both_paths_unavailable") ? 4 :
    !strcmp(decision.reason, "model_no_usable_route") ? 5 :
    !strcmp(decision.reason, "baseline_experiment_override") ? 6 : 0;
  const auto features = p12ganesh::ml::values(decision.features);
  for (size_t i = 0; i < 8; ++i)
    currentPacket.model_features[i] = decision.featuresValid ? (float)features[i] : NAN;
}
static void handleAcks() {
  RxFrame frame{};
  while (xQueueReceive(rxQueue, &frame, 0) == pdTRUE) {
    const MeshPacket &ack = frame.packet;
    if (isChannelSyncType(ack.type)) { processChannelSyncFrame(frame); continue; }
    if (channelState != CHANNEL_STATE_SYNCED) continue;
    if (ack.type == PACKET_DELIVERY_REPORT) {
      if (ack.version == PROTOCOL_VERSION && ack.source_id == GATEWAY_ID && ack.destination_id == NODE_ID &&
          !strncmp(ack.project_id, PROJECT_ID, sizeof(ack.project_id)) &&
          !strncmp(ack.network_id, NETWORK_ID, sizeof(ack.network_id)) &&
          !strncmp(ack.experiment_id, EXPERIMENT_ID, sizeof(ack.experiment_id)) &&
          ack.next_hop_id == NODE_ID && ack.sequence == pendingDeliverySequence &&
          ack.source_uptime_ms == pendingDeliveryUptime && ack.forwarding_node_id == selectedRelay &&
          ack.routing_algorithm == currentPacket.routing_algorithm && ack.hop_count == 2) {
        deliveryState = DELIVERY_CONFIRMED; deliveredViaRelay = ack.forwarding_node_id;
        uint32_t now = millis();
        if (ack.sequence != lastCountedDeliverySequence) {
          if (!throughputWindowStart || now - throughputWindowStart >= 30000UL) {
            throughputWindowStart = now; deliveredCount = 0; deliveredBits = 0; measuredThroughputBps = UNKNOWN_U32;
          }
          deliveredBits += (uint64_t)sizeof(MeshPacket) * 8ULL;
          ++deliveredCount; lastCountedDeliverySequence = ack.sequence;
          uint32_t elapsed = now - throughputWindowStart;
          if (deliveredCount >= 2 && elapsed) {
            uint64_t rate = deliveredBits * 1000ULL / elapsed;
            measuredThroughputBps = rate > UINT32_MAX ? UINT32_MAX : (uint32_t)rate;
          }
        }
        Serial.printf("DELIVERY_CONFIRMED seq=%lu prediction=%d selected=ESP32_%02u result=forwarded confirmation_rtt_ms=%lu mode=%s hop_count=%u\n",
          (unsigned long)ack.sequence,currentDecision.prediction,deliveredViaRelay,(unsigned long)(now-deliveryStartedAt),
          ack.routing_algorithm==ROUTING_ML_UPPER||ack.routing_algorithm==ROUTING_ML_LOWER?"ML_ACTIVE":"BASELINE_FALLBACK",ack.hop_count);
      }
      continue;
    }
    if (ack.type == PACKET_PATH_STATUS) { recordPathStatus(frame); continue; }
    if (ack.version != PROTOCOL_VERSION || ack.type != PACKET_ACK ||
        (ack.source_id != 2 && ack.source_id != 3) || ack.source_id != selectedRelay ||
        ack.next_hop_id != NODE_ID || ack.sequence != currentPacket.sequence ||
        ack.source_uptime_ms != currentPacket.source_uptime_ms || !waitingForAck) continue;
    waitingForAck = false;
    ++ackedPackets;
    lastAckRtt = millis() - lastSend;
    lastAckRssi = frame.rssi;
    lastAckRelay = ack.source_id; lastAckAt = millis();
    lastCommunicationAt = lastAckAt; lastAckSucceeded = true; hasTxResult = true;
    transmissions = 0;
    setLED(false, false, true);
    Serial.printf("ACK_OK seq=%lu relay=%u mode=%u prediction=%d rtt_ms=%lu rssi_dbm=%d ack=yes\n",
      (unsigned long)ack.sequence,ack.source_id,currentPacket.routing_algorithm,currentDecision.prediction,
      (unsigned long)lastAckRtt,lastAckRssi);
  }
}
static void serviceMesh() {
  handleAcks();
  serviceRoutingControl();
  if (channelState != CHANNEL_STATE_SYNCED) return;
  if (deliveryState == DELIVERY_PENDING && millis() - deliveryStartedAt > DELIVERY_REPORT_TIMEOUT) {
    deliveryState = DELIVERY_UNCONFIRMED;
    Serial.printf("DELIVERY_UNCONFIRMED seq=%lu prediction=%d selected=ESP32_%02u result=no_gateway_confirmation mode=%s\n",
      (unsigned long)pendingDeliverySequence,currentDecision.prediction,selectedRelay,
      currentPacket.routing_algorithm==ROUTING_ML_UPPER||currentPacket.routing_algorithm==ROUTING_ML_LOWER?"ML_NOT_CONFIRMED":"BASELINE_UNCONFIRMED");
  }
  if (waitingForAck) {
    if (!macSendFailed && millis() - lastSend < ACK_TIMEOUT) return;
    if (transmissions < MAX_TRANSMISSIONS) {
      ++transmissions; ++retryPackets;
      if (sendPacket()) { lastSend = millis(); setLED(false, true, false); }
      else macSendFailed = true;
      return;
    }
    ++failedPackets;
    lastAckSucceeded = false; hasTxResult = true;
    Serial.printf("SEND_FAILED seq=%lu attempts=%u\n", (unsigned long)currentPacket.sequence, transmissions);
    waitingForAck = false; transmissions = 0;
    setLED(true, false, false);
    return;
  }
  if (servicePathProbe()) return;
  if (millis() - lastSend < SEND_INTERVAL) return;
  RouteDecision decision = selectRoute();
  currentDecision = decision;
  setLED(false, true, false);
  if (!decision.nextHop) {
    if (!pythonOwnsRoute) {
      if (selectedRelay != 0) { lastRouteChangeReason = decision.reason; lastRouteChange = millis(); }
      selectedRelay = 0;
    }
    deliveryState = DELIVERY_NONE;
    lastSend = millis(); setLED(true, false, false);
    if (!decision.featuresValid) Serial.printf("ML INPUTS UNAVAILABLE; ");
    Serial.printf("ROUTE_DECISION uptime=%lu source=1 current=1 candidates=2,3 features_valid=%s prediction=%d selected=none mode=NO_VALID_ROUTE reason=%s\n",
      (unsigned long)millis(), decision.featuresValid ? "true" : "false", decision.prediction, decision.reason);
    return;
  }
  bool changed = selectedRelay != decision.nextHop;
  selectedRelay = decision.nextHop;
  if (changed) { lastRouteChange = millis(); lastRouteChangeReason = decision.reason; }
  makePacket(decision);
  currentPacket.route_change = changed ? 1 : 0;
  if (!changed) currentPacket.route_change_reason = 0;
  ++sentPackets;
  transmissions = 1;
  waitingForAck = true;
  bool txQueued = sendPacket();
  if (txQueued) lastSend = millis();
  else macSendFailed = true;
  pendingDeliverySequence = currentPacket.sequence;
  pendingDeliveryUptime = currentPacket.source_uptime_ms;
  deliveryStartedAt = millis();
  deliveryState = DELIVERY_PENDING;
  if (decision.featuresValid) {
    Serial.printf("ROUTE_DECISION uptime=%lu source=1 current=1 candidates=2,3 features=[%.4f,%.4f,%.2f,%.0f,%.4f,%.4f,%.2f,%.0f] features_valid=true prediction=%d selected=%u mode=%s result=%s ack=pending hop_count=0 route_change=%s reason=%s\n",
      (unsigned long)millis(),decision.features.upper_available,decision.features.upper_pdr_estimate,decision.features.upper_latency_ms,decision.features.upper_hops,
      decision.features.lower_available,decision.features.lower_pdr_estimate,decision.features.lower_latency_ms,decision.features.lower_hops,
      decision.prediction,decision.nextHop,decision.mode==ROUTING_ML_UPPER||decision.mode==ROUTING_ML_LOWER?"ML_PENDING":"BASELINE_FALLBACK",
      changed?"selected":"pending",changed?"yes":"no",decision.reason);
  } else {
    Serial.printf("ML INPUTS UNAVAILABLE; ROUTE_DECISION uptime=%lu source=1 current=1 candidates=2,3 features_valid=false prediction=unavailable selected=%u mode=BASELINE_FALLBACK result=pending hop_count=0 route_change=%s reason=%s\n",
      (unsigned long)millis(),decision.nextHop,changed?"yes":"no",decision.reason);
  }
  Serial.printf("SOURCE_SEND node=%s seq=%lu next_hop=%u routing_algorithm=%u tx=%s ack=pending\n", NODE_NAME,
    (unsigned long)currentPacket.sequence,currentPacket.next_hop_id,currentPacket.routing_algorithm,txQueued?"queued":"local_error");
}
static void drawScreen() {
  if (!oledReady || millis() - lastScreen < 500) return;
  lastScreen = millis();
  if (millis() - lastRotation >= 3500) { screen = (screen + 1) % 6; lastRotation = millis(); }
  display.setTextWrap(false);
  display.clearDisplay(); display.setTextColor(SH110X_WHITE); display.setTextSize(1); display.setCursor(0, 0);
  if (screen == 0) {
    display.println("P12-IOT");
    display.println("ML Mesh Routing");
    display.println("Node: ESP32_01");
    display.println("CraftIQ");
    display.printf("Firmware: %s", FIRMWARE_VERSION);
  } else if (screen == 1) {
    display.println("LIVE SENSORS");
    display.printf("Temp: %s C\n", dhtValid ? String(temperature, 1).c_str() : "--");
    display.printf("Humidity: %s %%\n", dhtValid ? String(humidity, 1).c_str() : "--");
    display.printf("Light: %s\n", lightStatus ? "DETECTED" : "NOT DETECTED");
    display.printf("Sound: %s\n", soundStatus ? "DETECTED" : "NOT DETECTED");
    display.printf("Validity: %s", dhtValid ? "VALID" : "INVALID");
  } else if (screen == 2) {
    display.println("ESP-NOW LINK");
    display.printf("Status: %s\n", channelState == CHANNEL_STATE_SYNCED ? "SYNCED" : "SEARCHING");
    display.printf("Next hop: %s\n", selectedRelay ? (selectedRelay == 2 ? "ESP32_02" : "ESP32_03") : "NONE");
    display.printf("ACK: %s", waitingForAck ? "PENDING" : hasTxResult ? (lastAckSucceeded ? "OK" : "FAILED") : "N/A");
  } else if (screen == 3) {
    display.println("ML ROUTING");
    if (currentDecision.featuresValid) display.println(P12_FORCE_BASELINE ? "Inference: DISABLED" : "Inference: RAN");
    else display.println("ML INPUTS UNAVAILABLE");
    const char *mode = currentDecision.mode == ROUTING_NO_VALID_ROUTE ? "NO_VALID_ROUTE" :
      currentDecision.mode == ROUTING_BASELINE_FALLBACK ? "BASELINE_FALLBACK" :
      deliveryState == DELIVERY_CONFIRMED ? "ML_ACTIVE" :
      deliveryState == DELIVERY_UNCONFIRMED ? "ML_NOT_CONFIRMED" : "ML_PENDING";
    display.println(mode);
    if (currentDecision.featuresValid)
      display.printf("%s\n", P12_FORCE_BASELINE ? "Pred: BASELINE" : currentDecision.prediction == 0 ? "Pred: UPPER (0)" : currentDecision.prediction == 1 ? "Pred: LOWER (1)" : "Pred: NO ROUTE (-1)");
    display.printf("Next: %s\n", selectedRelay ? (selectedRelay == 2 ? "ESP32_02" : "ESP32_03") : "NONE");
    display.printf("2:%s 3:%s\n", candidateState(candidates[0],millis()), candidateState(candidates[1],millis()));
    display.printf("Result: %s\n", deliveryState == DELIVERY_PENDING ? "PENDING" : deliveryState == DELIVERY_CONFIRMED ? "GATEWAY OK" : deliveryState == DELIVERY_UNCONFIRMED ? "NO CONFIRM" : "N/A");
    display.printf("Why: %.16s", shortRouteReason(lastRouteChangeReason));
  } else if (screen == 4) {
    display.println("TX COUNTERS");
    display.printf("Sent: %lu\n", (unsigned long)sentPackets);
    display.printf("ACKed: %lu\n", (unsigned long)ackedPackets);
    display.printf("Failed: %lu\n", (unsigned long)failedPackets);
    display.printf("Retries: %lu\n", (unsigned long)retryPackets);
    display.printf("Seq: %lu\n", (unsigned long)currentPacket.sequence);
    display.printf("Hop: %u\n", currentPacket.hop_count);
    display.printf("ACK: %s", waitingForAck ? "PENDING" : hasTxResult ? (lastAckSucceeded ? "OK" : "FAILED") : "N/A");
  } else {
    display.println("NETWORK / CLOUD");
    display.println("Cloud via node 4");
    display.println("WiFi on gateway");
    display.printf("Net: %s\n", NETWORK_ID);
    display.printf("Radio ch: %u\n", meshChannel);
    if (lastCommunicationAt) display.printf("Mesh age: %lu s", (unsigned long)((millis() - lastCommunicationAt) / 1000));
    else display.println("Last mesh: N/A");
  }
  display.display();
}
void setup() {
  Serial.begin(115200);
  pinMode(LDR_PIN, INPUT); pinMode(SOUND_PIN, INPUT);
  pinMode(LED_RED, OUTPUT); pinMode(LED_YELLOW, OUTPUT); pinMode(LED_GREEN, OUTPUT);
  setLED(false, false, false);
  digitalWrite(LED_RED, LOW); digitalWrite(LED_YELLOW, LOW); digitalWrite(LED_GREEN, LOW);
  dht.begin(); Wire.begin(OLED_SDA, OLED_SCL);
  oledReady = display.begin(OLED_ADDRESS, true);
  rxQueue = xQueueCreate(8, sizeof(RxFrame));
  if (!rxQueue) { Serial.println("ERROR ack_queue"); while (true) delay(1000); }
  routingControlQueue=xQueueCreate(4,sizeof(RoutingControlRx));
  if(!routingControlQueue) Serial.println("ROUTE_CONTROL_UNAVAILABLE reason=queue_allocation_failed owner=firmware_fallback");
  if(routingPrefs.begin("p12route",false)) {
    routingControlEpoch=routingPrefs.getUInt("epoch",0);
    lastPythonCommandSequence=routingPrefs.getUInt("command",0);
    lastPythonCommandResult=routingPrefs.getUChar("result",ROUTING_RESULT_REJECTED);
  }
  WiFi.mode(WIFI_STA); WiFi.setSleep(false);
  esp_wifi_set_channel(MESH_BOOT_CHANNEL, WIFI_SECOND_CHAN_NONE);
  configureChannelScanRange();
    if (esp_now_init() != ESP_OK) { Serial.println("ERROR esp_now_init"); while (true) delay(1000); }
  espNowReady = true;
  addPeer(BROADCAST_MAC);
  esp_now_register_recv_cb(receiveCallback);
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  esp_now_register_send_cb(sendCallback);
#else
  esp_now_register_send_cb(sendCallbackLegacy);
#endif
  lastSend = millis() - SEND_INTERVAL; lastSensorRead = millis() - SENSOR_INTERVAL;
  lastPathProbe = millis() - PATH_PROBE_INTERVAL;
  startChannelScan("boot");
  Serial.printf("READY %s channel=%u mac=%s mesh=discovering\n", NODE_NAME, meshChannel, WiFi.macAddress().c_str());
}
void loop() {
  readSensors(); serviceChannelSync(); serviceMesh(); drawScreen();
  serviceStatusLED(waitingForAck);
  delay(1);
}
