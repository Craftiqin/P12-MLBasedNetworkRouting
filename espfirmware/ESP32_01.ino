  if (!strcmp(reason, "model_class_lower")) return "model lower";
  if (!strcmp(reason, "invalid_model_class")) return "invalid model";
  if (!strcmp(reason, "model_route_improved")) return "model improved";
  if (!strcmp(reason, "model_selected_route")) return "model selection";
  if (!strcmp(reason, "both_paths_unavailable")) return "both paths down";
  if (!strcmp(reason, "model_no_usable_route")) return "model no route";
  if (!strcmp(reason, "model_predicted_unavailable_candidate")) return "safe fallback";
  if (!strcmp(reason, "baseline_experiment_override")) return "baseline mode";
  if (!strcmp(reason, "metric_window_warming")) return "probing";
  if (!strcmp(reason, "safe_selector_no_route")) return "no safe route";
  if (!strcmp(reason, "invalid_prediction_no_safe_candidate")) return "bad prediction";
  return reason;
}
static bool routeFeaturesValid(uint32_t now, p12ganesh::ml::RouteFeatures &f) {
  for (uint8_t i = 0; i < 2; ++i) {
    const CandidatePath &c = candidates[i];
    if (c.attempts < PATH_MIN_SAMPLES || c.responses == 0 || c.responses > c.attempts || !c.gatewayAvailabilityKnown ||
        !pathStatusFresh(c, now) || c.gatewayLossPercent > 100 ||
        c.gatewayLatencyMs == UNKNOWN_U16 || c.pathHops == 0) return false;
  }
  const double pdr2 = (double)candidates[0].responses / candidates[0].attempts *
                      (100.0 - candidates[0].gatewayLossPercent) / 100.0;
  const double pdr3 = (double)candidates[1].responses / candidates[1].attempts *
                      (100.0 - candidates[1].gatewayLossPercent) / 100.0;
  // Model expects path delay; probes measure request/ACK RTT, so estimate one-way delay as RTT/2 per link.
  const double latency2 = ((double)candidates[0].sourceRttTotalMs / candidates[0].responses + candidates[0].gatewayLatencyMs) / 2.0;
  const double latency3 = ((double)candidates[1].sourceRttTotalMs / candidates[1].responses + candidates[1].gatewayLatencyMs) / 2.0;
  f = {candidates[0].gatewayAvailable ? 1.0 : 0.0, pdr2, latency2, (double)candidates[0].pathHops,
       candidates[1].gatewayAvailable ? 1.0 : 0.0, pdr3, latency3, (double)candidates[1].pathHops};
  const auto x = p12ganesh::ml::values(f);
  for (double value : x) if (!std::isfinite(value)) return false;
  return pdr2 >= 0 && pdr2 <= 1 && pdr3 >= 0 && pdr3 <= 1 && latency2 >= 0 && latency3 >= 0;
}
static bool candidateMetricsAvailable(const CandidatePath &c, uint32_t now, double &pdr, double &latencyMs) {
  if (c.attempts < PATH_MIN_SAMPLES || c.responses == 0 || !pathStatusFresh(c, now) ||
      !c.gatewayAvailable || c.pathHops == 0) return false;
  pdr = ((double)c.responses / c.attempts) * ((100.0 - c.gatewayLossPercent) / 100.0);
  latencyMs = ((double)c.sourceRttTotalMs / c.responses + c.gatewayLatencyMs) / 2.0;
  return std::isfinite(pdr) && pdr >= 0.0 && pdr <= 1.0 && std::isfinite(latencyMs) && latencyMs >= 0.0;
}
static bool bothRoutesKnownDown(uint32_t now) {
  for (const CandidatePath &c : candidates) {
    if (c.attempts < PATH_MIN_SAMPLES) return false;
    bool sourceUnavailable = c.responses == 0;
    bool gatewayUnavailable = c.responses >= PATH_MIN_SAMPLES && c.lastStatusMs &&
      now-c.lastStatusMs<=PATH_STATUS_MAX_AGE && c.gatewayLossPercent<=100 && !c.gatewayAvailable;
    if (!sourceUnavailable && !gatewayUnavailable) return false;
  }
  return true;
}
static void recordPathStatus(const RxFrame &frame) {
  const MeshPacket &p = frame.packet;
  if (p.version != PROTOCOL_VERSION || strncmp(p.project_id,PROJECT_ID,sizeof(p.project_id)) ||
      strncmp(p.network_id,NETWORK_ID,sizeof(p.network_id)) ||
      strncmp(p.experiment_id,EXPERIMENT_ID,sizeof(p.experiment_id)) ||
      p.source_id < 2 || p.source_id > 3 || p.destination_id != NODE_ID ||
      p.sequence != pathProbeSequence || p.type != PACKET_PATH_STATUS) return;
  // PATH_STATUS: 1=up, 0=measured down, 255=unknown; never treat unknown as down.
  if ((p.feature_valid > 1 && p.feature_valid != 255) || p.hop_count > MAX_HOPS) return;
  CandidatePath &c = candidateFor(p.source_id);
  if (c.lastStatusSequence == p.sequence) return;
  c.lastStatusSequence = p.sequence;
  c.lastStatusMs = millis();
  lastCommunicationAt = c.lastStatusMs;
  if (c.responses < UINT16_MAX) ++c.responses;
  c.sourceRttTotalMs += (uint32_t)(millis() - p.source_uptime_ms);
  c.gatewayLatencyMs = p.latency_ms;
  c.gatewayLossPercent = p.packet_loss_percent;
  c.gatewayAvailable = p.feature_valid == 1;
  c.gatewayAvailabilityKnown = p.feature_valid <= 1;
  c.pathHops = p.hop_count;
}
static bool servicePathProbe() {
  uint32_t now = millis();
  if (waitingForAck || now - lastPathProbe < PATH_PROBE_INTERVAL) return false;
  for (CandidatePath &c : candidates) { resetProbeWindowIfNeeded(c, now); if (c.attempts < UINT16_MAX) ++c.attempts; }
  MeshPacket p{}; p.version = PROTOCOL_VERSION; p.type = PACKET_PATH_PROBE;
  copyText(p.project_id, sizeof(p.project_id), PROJECT_ID); copyText(p.network_id, sizeof(p.network_id), NETWORK_ID);
  copyText(p.experiment_id, sizeof(p.experiment_id), EXPERIMENT_ID);
  p.source_id = NODE_ID; p.destination_id = GATEWAY_ID; p.forwarding_node_id = NODE_ID;
  p.sequence = ++pathProbeSequence; p.source_uptime_ms = now; p.hop_limit = MAX_HOPS;
  bool sent = sendBroadcast(p); lastPathProbe = now;
  Serial.printf("PATH_PROBE seq=%lu tx=%s\n", (unsigned long)p.sequence, sent ? "ok" : "failed");
  return true;
}
static RouteDecision selectRoute() {
  RouteDecision d{}; uint32_t now = millis();
  d.featuresValid = routeFeaturesValid(now, d.features);
  if (pythonOwnsRoute) {
    if (selectedRelay==2 || selectedRelay==3) {
      const CandidatePath &active=candidateFor(selectedRelay);
      if (active.gatewayAvailabilityKnown && active.gatewayAvailable && pathStatusFresh(active,now) &&
          active.attempts>=PATH_MIN_SAMPLES && active.responses>0 && active.pathHops>0 && active.pathHops<MAX_HOPS) {
        d.nextHop=selectedRelay; d.mode=selectedRelay==2?ROUTING_ML_UPPER:ROUTING_ML_LOWER;
        d.reason="python_route_ownership"; return d;
      }
    }
    d.mode=ROUTING_NO_VALID_ROUTE; d.reason="python_owned_route_unavailable"; return d;
  }
  if (bothRoutesKnownDown(now)) { d.mode = ROUTING_NO_VALID_ROUTE; d.reason = "both_paths_unavailable"; return d; }
  if (d.featuresValid && !P12_FORCE_BASELINE) {
    d.prediction = p12ganesh::ml::predict(d.features);
    const int safeSelection = p12ganesh::ml::selectSafely(d.prediction, d.features);
    if (safeSelection >= 0) {
      d.nextHop = safeSelection == 0 ? 2 : 3;
      if (d.prediction == safeSelection) {
        d.mode = d.prediction == 0 ? ROUTING_ML_UPPER : ROUTING_ML_LOWER;
        d.reason = d.prediction == 0 ? "model_class_upper" : "model_class_lower";
      } else {
        d.mode = ROUTING_BASELINE_FALLBACK;
        d.reason = "model_predicted_unavailable_candidate";
      }
      return d;
    }
    d.mode = ROUTING_NO_VALID_ROUTE;
    d.reason = d.prediction == -1 ? "model_no_usable_route" : "invalid_prediction_no_safe_candidate";
    return d;
  } else if (d.featuresValid) d.reason = "baseline_experiment_override";
  else d.reason = "required_candidate_metrics_missing_or_stale";

  d.mode = ROUTING_BASELINE_FALLBACK;
  if (candidates[0].lastStatusMs && now-candidates[0].lastStatusMs<=PATH_STATUS_MAX_AGE &&
      candidates[0].gatewayAvailabilityKnown && candidates[0].gatewayAvailable) d.nextHop = 2;
  else if (candidates[1].lastStatusMs && now-candidates[1].lastStatusMs<=PATH_STATUS_MAX_AGE &&
           candidates[1].gatewayAvailabilityKnown && candidates[1].gatewayAvailable) d.nextHop = 3;
  else {
    d.mode = ROUTING_NO_VALID_ROUTE;
    d.reason = bothRoutesKnownDown(now) ? "both_paths_unavailable" : "required_candidate_metrics_missing_or_stale";
  }
  return d;
}

void setLED(bool red, bool yellow, bool green) {
  uint32_t now = millis();
  if (red) ledRedUntil = now + LED_ERROR_HOLD_MS;
  if (yellow) ledYellowUntil = now + LED_ACTIVITY_HOLD_MS;
  if (green) ledGreenUntil = now + LED_SUCCESS_HOLD_MS;
  if (!red && !yellow && !green) ledRedUntil = ledYellowUntil = ledGreenUntil = now;
}
static void serviceStatusLED(bool processingActive) {
  uint32_t now = millis();
  bool errorActive = currentDecision.mode == ROUTING_NO_VALID_ROUTE || deliveryState == DELIVERY_UNCONFIRMED;
  bool red = errorActive || (int32_t)(ledRedUntil - now) > 0;
  bool yellow = !red && (processingActive || (int32_t)(ledYellowUntil - now) > 0);
  bool green = !red && !yellow && (int32_t)(ledGreenUntil - now) > 0;
  if (red != ledRedOn) digitalWrite(LED_RED, red ? HIGH : LOW);
  if (yellow != ledYellowOn) digitalWrite(LED_YELLOW, yellow ? HIGH : LOW);
  if (green != ledGreenOn) digitalWrite(LED_GREEN, green ? HIGH : LOW);
  ledRedOn = red; ledYellowOn = yellow; ledGreenOn = green;
}

// Preserved original working sensor implementation exactly.
void readSensors() {

  if (millis() - lastSensorRead >= 2000) {

    lastSensorRead = millis();

    float t = dht.readTemperature();
    float h = dht.readHumidity();

    dhtValid = !isnan(t) && !isnan(h);

    if (dhtValid) {

      temperature = t;
      humidity = h;

    }

  }

  // Original LDR detection logic
  lightStatus =
    digitalRead(LDR_PIN) == LDR_ACTIVE;

  // Original sound detection logic
  soundStatus =
    digitalRead(SOUND_PIN) == SOUND_ACTIVE;

}
