static void remember(const MeshPacket&p){seen[seenCursor]={p.source_id,p.sequence,p.source_uptime_ms};seenCursor=(seenCursor+1)%SEEN_SIZE;}
static bool seenBefore(const MeshPacket&p){for(const auto&k:seen)if(k.source==p.source_id&&k.sequence==p.sequence&&k.uptime==p.source_uptime_ms)return true;return false;}
static void sendAck(uint8_t previous,uint32_t seq,uint32_t uptime,const uint8_t*mac){
  MeshPacket a{};a.version=PROTOCOL_VERSION;a.type=PACKET_ACK;
  copyText(a.project_id,sizeof(a.project_id),PROJECT_ID);copyText(a.network_id,sizeof(a.network_id),NETWORK_ID);copyText(a.experiment_id,sizeof(a.experiment_id),EXPERIMENT_ID);
  a.source_id=NODE_ID;a.destination_id=previous;a.next_hop_id=previous;a.forwarding_node_id=NODE_ID;a.sequence=seq;a.source_uptime_ms=uptime;
  if(addPeer(mac))esp_now_send(mac,reinterpret_cast<const uint8_t*>(&a),sizeof(a));
}
static void sendDeliveryReport(const MeshPacket&p,const uint8_t*mac){
  MeshPacket report{};report.version=PROTOCOL_VERSION;report.type=PACKET_DELIVERY_REPORT;
  copyText(report.project_id,sizeof(report.project_id),PROJECT_ID);copyText(report.network_id,sizeof(report.network_id),NETWORK_ID);
  copyText(report.experiment_id,sizeof(report.experiment_id),EXPERIMENT_ID);
  report.source_id=NODE_ID;report.destination_id=p.source_id;report.next_hop_id=p.source_id;
  report.forwarding_node_id=p.forwarding_node_id;report.routing_algorithm=p.routing_algorithm;
  report.sequence=p.sequence;report.source_uptime_ms=p.source_uptime_ms;
  report.hop_count=p.hop_count<MAX_HOPS?p.hop_count+1:p.hop_count;
  if(addPeer(mac))esp_now_send(mac,reinterpret_cast<const uint8_t*>(&report),sizeof(report));
}
static void sendGatewayProbeAck(const RxFrame&f){
  const MeshPacket&p=f.packet;MeshPacket a{};a.version=PROTOCOL_VERSION;a.type=PACKET_GATEWAY_PROBE_ACK;
  copyText(a.project_id,sizeof(a.project_id),PROJECT_ID);copyText(a.network_id,sizeof(a.network_id),NETWORK_ID);
  copyText(a.experiment_id,sizeof(a.experiment_id),EXPERIMENT_ID);
  a.source_id=NODE_ID;a.destination_id=p.source_id;a.next_hop_id=p.source_id;a.forwarding_node_id=NODE_ID;
  a.sequence=p.sequence;a.source_uptime_ms=p.source_uptime_ms;a.hop_count=p.hop_count+1;
  if(addPeer(f.mac))esp_now_send(f.mac,reinterpret_cast<const uint8_t*>(&a),sizeof(a));
}
static void processIncoming(const RxFrame&f){
  const MeshPacket&p=f.packet;
  if(p.version!=PROTOCOL_VERSION||strncmp(p.project_id,PROJECT_ID,sizeof(p.project_id))||strncmp(p.network_id,NETWORK_ID,sizeof(p.network_id))||strncmp(p.experiment_id,EXPERIMENT_ID,sizeof(p.experiment_id)))return;
  if(isChannelSyncType(p.type)){processChannelSyncFrame(f);return;}
  requestStatusLED(LED_COLOR_GREEN,LED_SUCCESS_HOLD_MS);
  if(p.type==PACKET_GATEWAY_PROBE&&p.destination_id==NODE_ID&&(p.source_id==2||p.source_id==3)){
    sendGatewayProbeAck(f);return;
  }
  if(p.type!=PACKET_DATA||p.next_hop_id!=GATEWAY_ID||p.destination_id!=GATEWAY_ID||p.source_id==NODE_ID||p.source_id<1||p.source_id>3||p.hop_count>=p.hop_limit)return;
  requestStatusLED(LED_COLOR_YELLOW,LED_ACTIVITY_HOLD_MS);
  ++received;currentRssi=f.rssi;
  if(seenBefore(p)){++duplicates;sendAck(p.forwarding_node_id,p.sequence,p.source_uptime_ms,f.mac);sendDeliveryReport(p,f.mac);return;}
  MeshPacket accepted=p;accepted.last_hop_rssi_dbm=f.rssi;++accepted.hop_count;
  bool uploadQueuesFull=false;
  portENTER_CRITICAL(&uploadQueueMux);
  if(qCount>=QUEUE_SIZE||routeCount>=QUEUE_SIZE)uploadQueuesFull=true;
  else{
    telemetry[qTail]=accepted;qTail=(qTail+1)%QUEUE_SIZE;++qCount;
    routingEvents[(routeHead+routeCount)%QUEUE_SIZE]=accepted;++routeCount;
  }
  portEXIT_CRITICAL(&uploadQueueMux);
  if(uploadQueuesFull){
    __atomic_add_fetch(&backpressureRejected,1,__ATOMIC_RELAXED);
    requestStatusLED(LED_COLOR_RED,LED_ERROR_HOLD_MS);
    Serial.printf("UPLOAD_BACKPRESSURE seq=%lu sensor_queue=%u route_queue=%u; not_acked_retry=true\n",
      (unsigned long)p.sequence,queuedTelemetry(),queuedRoutingEvents());
    return;
  }
  latest=accepted;remember(p);
  sendAck(p.forwarding_node_id,p.sequence,p.source_uptime_ms,f.mac);
  sendDeliveryReport(p,f.mac);
  Serial.printf("GATEWAY_DELIVERY seq=%lu src=%u relay=%u mode=%s routing_algorithm=%u result=received hop_count=%u\n",
    (unsigned long)p.sequence,p.source_id,p.forwarding_node_id,
    p.routing_algorithm==ROUTING_ML_UPPER||p.routing_algorithm==ROUTING_ML_LOWER?"ML_ACTIVE":"BASELINE_FALLBACK",
    p.routing_algorithm,accepted.hop_count);
}
static void serviceRx(){
  RxFrame f{};while(xQueueReceive(rxQueue,&f,0)==pdTRUE)processIncoming(f);
}
