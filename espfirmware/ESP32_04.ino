class P12TrackedTlsClient : public WiFiClientSecure {
 public:
  uint32_t connectAttempts=0,connectElapsedMs=0;
  int connectResult=0;
  size_t headerBytesAttempted=0,headerBytesWritten=0;
  size_t bodyBytesAttempted=0,bodyBytesWritten=0;
  bool bodyStarted=false;
  uint8_t headerTerminatorMatch=0;

  int connect(const char*host,uint16_t port,int32_t timeout) override {
    ++connectAttempts;
    const uint32_t started=millis();
    connectResult=WiFiClientSecure::connect(host,port,timeout);
    connectElapsedMs=millis()-started;
    return connectResult;
  }

  size_t write(const uint8_t*data,size_t size) override {
    const bool wasBody=bodyStarted;
    const size_t written=WiFiClientSecure::write(data,size);
    if(wasBody){
      bodyBytesAttempted+=size;
      bodyBytesWritten+=written;
    }else{
      headerBytesAttempted+=size;
      headerBytesWritten+=written;
      for(size_t i=0;i<size&&!bodyStarted;++i){
        const char c=static_cast<char>(data[i]);
        if((headerTerminatorMatch==0||headerTerminatorMatch==2)&&c=='\r')++headerTerminatorMatch;
        else if((headerTerminatorMatch==1||headerTerminatorMatch==3)&&c=='\n'){
          ++headerTerminatorMatch;
          if(headerTerminatorMatch==4)bodyStarted=true;
        }else headerTerminatorMatch=(c=='\r')?1:0;
      }
    }
    return written;
  }

  size_t write(uint8_t value) override { return write(&value,1); }
};

