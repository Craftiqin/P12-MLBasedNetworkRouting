static const char* apiEndpointName(const char*url){
  return strstr(url,"/routing-events")?"routing_events":"iot_data";
}
static const char* httpStatusName(int status){
  if(status>=200&&status<300)return "success";
  if(status==401)return "unauthorized";
  if(status==403)return "forbidden";
  if(status==404)return "not_found";
  if(status==422)return "validation_error";
  if(status==429)return "rate_limited";
  if(status>=500)return "server_error";
  if(status>=400)return "client_error";
  return "unknown";
}
static const char* transportErrorName(int status){
  if(status==HTTPC_ERROR_READ_TIMEOUT)return "timeout";
  if(status==HTTPC_ERROR_CONNECTION_REFUSED)return "connect_failed";
  if(status==HTTPC_ERROR_NOT_CONNECTED||status==HTTPC_ERROR_CONNECTION_LOST)return "connection_lost";
  if(status==HTTPC_ERROR_SEND_HEADER_FAILED||status==HTTPC_ERROR_SEND_PAYLOAD_FAILED)return "send_failed";
  if(status==HTTPC_ERROR_NO_STREAM||status==HTTPC_ERROR_NO_HTTP_SERVER)return "no_http_response";
  return "transport_error";
}
static const char* postFailurePhase(int status,const P12TrackedTlsClient&tls){
  if(status==HTTPC_ERROR_CONNECTION_REFUSED)
    return tls.connectResult==1?"socket_disconnected_before_http_send":"connect_or_tls_handshake";
  if(status==HTTPC_ERROR_SEND_HEADER_FAILED)return "request_header_write";
  if(status==HTTPC_ERROR_SEND_PAYLOAD_FAILED)return "request_body_write";
  if(status==HTTPC_ERROR_NOT_CONNECTED)return "socket_not_connected";
  if(status==HTTPC_ERROR_CONNECTION_LOST)return "socket_lost_while_reading_response";
  if(status==HTTPC_ERROR_NO_HTTP_SERVER)return "malformed_or_missing_http_status_line";
  if(status==HTTPC_ERROR_READ_TIMEOUT)return "response_read_timeout";
  if(status==HTTPC_ERROR_NO_STREAM)return "response_stream_unavailable";
  return "httpclient_transport";
}
static const char* postFailureClass(int status,int tlsCode,const P12TrackedTlsClient&tls){
  if(status==HTTPC_ERROR_CONNECTION_REFUSED&&tlsCode==-0x0050)
    return tls.connectResult==1?"peer_reset_before_http_send":"peer_reset_during_connect";
  if(status==HTTPC_ERROR_SEND_HEADER_FAILED)return "request_header_write_failed";
  if(status==HTTPC_ERROR_SEND_PAYLOAD_FAILED)return "request_body_write_failed";
  if(status==HTTPC_ERROR_CONNECTION_LOST)return "socket_reset_or_closed_while_reading";
  if(status==HTTPC_ERROR_READ_TIMEOUT)return "response_timeout";
  if(status==HTTPC_ERROR_NO_HTTP_SERVER)return "malformed_http_response";
  if(status==HTTPC_ERROR_CONNECTION_REFUSED)return tls.connectResult==1?"socket_closed_before_http_send":"tcp_or_tls_connect_failed";
  return transportErrorName(status);
}
static void logTlsHeap(const char*endpoint){
  const uint32_t freeInternal=heap_caps_get_free_size(MALLOC_CAP_INTERNAL|MALLOC_CAP_8BIT);
  const uint32_t largestInternal=heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL|MALLOC_CAP_8BIT);
  const uint32_t free8Bit=heap_caps_get_free_size(MALLOC_CAP_8BIT);
  const uint32_t largest8Bit=heap_caps_get_largest_free_block(MALLOC_CAP_8BIT);
  Serial.printf("TLS_HEAP endpoint=%s free_internal=%lu largest_internal=%lu free_8bit=%lu largest_8bit=%lu\n",
    endpoint,(unsigned long)freeInternal,(unsigned long)largestInternal,(unsigned long)free8Bit,(unsigned long)largest8Bit);
}
static String sanitizeApiLogText(String value){
  if(strlen(API_AUTH_TOKEN)>0)value.replace(API_AUTH_TOKEN,"[REDACTED]");
  const char* sensitiveKeys[]={"authorization","token","password","secret","apikey"};
  for(const char*key:sensitiveKeys){
    String needle=String("\"")+key+"\"";
    for(;;){
      String lower=value;lower.toLowerCase();int keyAt=lower.indexOf(needle);if(keyAt<0)break;
      int colon=lower.indexOf(':',keyAt+needle.length());if(colon<0)break;
      int start=colon+1;while(start<(int)value.length()&&isspace((unsigned char)value[start]))++start;
      int end=start;
      if(start<(int)value.length()&&value[start]=='\"'){
        ++start;end=start;bool escaped=false;
        while(end<(int)value.length()){
          char c=value[end];if(c=='\"'&&!escaped)break;
          if(c=='\\'&&!escaped)escaped=true;else escaped=false;++end;
        }
      }else{
        while(end<(int)value.length()&&value[end]!=','&&value[end]!='}'&&!isspace((unsigned char)value[end]))++end;
      }
      value=value.substring(0,start)+"[REDACTED]"+value.substring(end);
    }
  }
  String lower=value;lower.toLowerCase();int bearer=lower.indexOf("bearer ");
  if(bearer>=0){int start=bearer+7,end=start;while(end<(int)value.length()&&!isspace((unsigned char)value[end])&&value[end]!='\"'&&value[end]!=','&&value[end]!='}')++end;value=value.substring(0,start)+"[REDACTED]"+value.substring(end);}
  for(size_t i=0;i<value.length();++i)if((unsigned char)value[i]<32||(unsigned char)value[i]>126)value.setCharAt(i,' ');
  if(value.length()>240)value=value.substring(0,240)+"...";
  return value;
}
static bool postJson(const char*url,const String&body){
  const char*endpoint=apiEndpointName(url);
  const uint32_t requestStarted=millis();
  const size_t requestBytes=body.length();
  if(WiFi.status()!=WL_CONNECTED){Serial.printf("API_CONNECT_ERROR endpoint=%s reason=wifi_disconnected request_sent=false\n",endpoint);return false;}
  if(!clockSyncReady||!systemClockValid()){
    clockSyncReady=false;
    Serial.printf("API_CLOCK_NOT_READY endpoint=%s request_sent=false queue_retained=true\n",endpoint);
    return false;
  }
  if(String(API_AUTH_TOKEN).length()==0||String(API_AUTH_TOKEN)=="SET_P12_IOT_BEARER_TOKEN"){
    Serial.printf("API_AUTH_CONFIG_ERROR endpoint=%s reason=token_placeholder request_sent=false\n",endpoint);return false;
  }
  if(requestBytes<2||body[0]!='{'||body[requestBytes-1]!='}'){
    Serial.printf("API_PAYLOAD_ERROR endpoint=%s bytes=%u reason=not_json_object request_sent=false\n",endpoint,(unsigned)requestBytes);return false;
  }
  logTlsHeap(endpoint);
  Serial.printf("API_REQUEST_PREP endpoint=%s bytes=%u content_type=application/json auth=bearer tls=verified hostname=%s connection=fresh\n",
    endpoint,(unsigned)requestBytes,API_HOST);
  P12TrackedTlsClient tls;
  tls.setCACert(ROOT_CA_CERTIFICATE);
  tls.setTimeout(8000);
  HTTPClient http;
  http.setReuse(false);
  http.setConnectTimeout(8000);
  http.setTimeout(8000);
  if(!http.begin(tls,url)){
    char tlsDetail[128]{};int tlsCode=tls.lastError(tlsDetail,sizeof(tlsDetail));
    Serial.printf("API_HTTP_BEGIN_ERROR endpoint=%s tls_code=%d tls_detail=%s request_sent=false bytes=%u\n",
      endpoint,tlsCode,sanitizeApiLogText(String(tlsDetail)).c_str(),(unsigned)requestBytes);
    http.end();tls.stop();return false;
  }
  http.addHeader("Content-Type","application/json");
  http.addHeader("Authorization",String("Bearer ")+API_AUTH_TOKEN);
  Serial.printf("API_HTTP_POST_START endpoint=%s body_bytes=%u content_type=application/json auth=bearer host=%s content_length=automatic connection=close tls=verified connect=HTTPClient\n",
    endpoint,(unsigned)requestBytes,API_HOST);
  const int status=http.POST(body);
  String response=status>0?http.getString():"";
  if(status<0){
    char tlsDetail[128]{};int tlsCode=tls.lastError(tlsDetail,sizeof(tlsDetail));
    const char*failurePhase=postFailurePhase(status,tls);
    const char*failureClass=postFailureClass(status,tlsCode,tls);
    String detail=tlsCode!=0?sanitizeApiLogText(String(tlsDetail)):sanitizeApiLogText(http.errorToString(status));
    Serial.printf("API_HTTP_TRANSPORT_ERROR endpoint=%s phase=%s class=%s httpclient_code=%d detail=%s tls_code=%d tls_detail=%s connect_attempts=%lu connect_result=%d connect_ms=%lu header_written=%u/%u body_attempted=%u body_written=%u/%u request_sent=%s elapsed_ms=%lu\n",
      endpoint,failurePhase,failureClass,status,detail.c_str(),tlsCode,sanitizeApiLogText(String(tlsDetail)).c_str(),
      (unsigned long)tls.connectAttempts,tls.connectResult,(unsigned long)tls.connectElapsedMs,
      (unsigned)tls.headerBytesWritten,(unsigned)tls.headerBytesAttempted,
      (unsigned)tls.bodyBytesAttempted,(unsigned)tls.bodyBytesWritten,(unsigned)requestBytes,tls.bodyBytesWritten==requestBytes?"yes":"no",
      (unsigned long)(millis()-requestStarted));
  }else{
    const bool success=response.indexOf("\"success\":true")>=0;
    Serial.printf("API_HTTP_RESPONSE endpoint=%s status=%d class=%s connect_attempts=%lu connect_result=%d header_written=%u/%u body_attempted=%u body_written=%u/%u response_bytes=%u body=%s elapsed_ms=%lu\n",
      endpoint,status,httpStatusName(status),(unsigned long)tls.connectAttempts,tls.connectResult,
      (unsigned)tls.headerBytesWritten,(unsigned)tls.headerBytesAttempted,
      (unsigned)tls.bodyBytesAttempted,(unsigned)tls.bodyBytesWritten,(unsigned)requestBytes,
      (unsigned)response.length(),sanitizeApiLogText(response).c_str(),
      (unsigned long)(millis()-requestStarted));
    if(status>=200&&status<300&&!success)
      Serial.printf("API_RESPONSE_PARSE_ERROR endpoint=%s status=%d reason=success_flag_missing response_bytes=%u\n",
        endpoint,status,(unsigned)response.length());
    else if(status<200||status>=300)
      Serial.printf("API_HTTP_FAILURE endpoint=%s status=%d class=%s request_bytes=%u\n",
        endpoint,status,httpStatusName(status),(unsigned)requestBytes);
  }
  http.end();tls.stop();
  return status>=200&&status<300&&response.indexOf("\"success\":true")>=0;
}
