static void reconnectWiFi(){
  if(millis()-lastWifiRetry<WIFI_RETRY_MS)return;lastWifiRetry=millis();
  if(String(WIFI_SSID)=="SET_WIFI_SSID"||strlen(WIFI_SSID)==0)return;
  WiFi.begin(WIFI_SSID,WIFI_PASSWORD);
}
static void serviceWiFi(){
  bool wasReady=wifiReady;
  wifiReady=WiFi.status()==WL_CONNECTED;
  if(wifiReady){
    uint8_t apChannel=WiFi.channel();
    if(apChannel>=1&&apChannel<=13&&apChannel!=meshChannel){
      uint8_t oldChannel=meshChannel;previousMeshChannel=oldChannel;meshChannel=apChannel;
      memset(channelSyncAckAt,0,sizeof(channelSyncAckAt));meshReadyReported=false;channelNoticePending=true;
      Serial.printf("WIFI_CHANNEL_CHANGED old_channel=%u new_channel=%u\n",oldChannel,meshChannel);
      Serial.printf("MESH_RESYNC_START channel=%u\n",meshChannel);
    }
    if(!wasReady){
      memset(channelSyncAckAt,0,sizeof(channelSyncAckAt));meshReadyReported=false;channelNoticePending=true;
      Serial.printf("WIFI_CONNECTED channel=%u\n",meshChannel);
      Serial.printf("MESH_RESYNC_START channel=%u reason=wifi_reconnected\n",meshChannel);
    }
  }else if(wasReady){
    memset(channelSyncAckAt,0,sizeof(channelSyncAckAt));meshReadyReported=false;
    Serial.println("CLOUD_OUTAGE reason=wifi_link_lost; mesh_beacons_paused; queued_uploads_retained");
  }
  if(!wifiReady)reconnectWiFi();
}
static bool systemClockValid(){return time(nullptr)>=MIN_VALID_UTC_EPOCH;}
static void serviceClockSync(){
  uint32_t now=millis();time_t utcNow=time(nullptr);
  if(utcNow>=MIN_VALID_UTC_EPOCH){
    if(!clockSyncReady)Serial.printf("CLOCK_SYNC_OK timezone=UTC epoch=%lld\n",(long long)utcNow);
    clockSyncReady=true;clockSyncActive=false;return;
  }
  if(clockSyncReady){clockSyncReady=false;Serial.println("CLOCK_SYNC_LOST https_blocked=true");}
  if(WiFi.status()!=WL_CONNECTED)return;
  if(!clockSyncActive){
    if(clockSyncAttempted&&now-lastClockSyncAttemptAt<NTP_SYNC_RETRY_MS)return;
    configTime(0,0,"pool.ntp.org","time.google.com","time.cloudflare.com");
    clockSyncAttempted=true;clockSyncActive=true;clockSyncStartedAt=now;
    lastClockSyncAttemptAt=now;lastClockSyncPollAt=now-CLOCK_POLL_INTERVAL_MS;
    Serial.printf("CLOCK_SYNC_START timezone=UTC timeout_ms=%lu\n",(unsigned long)NTP_SYNC_TIMEOUT_MS);
  }
  now=millis();
  if(now-lastClockSyncPollAt<CLOCK_POLL_INTERVAL_MS&&now-clockSyncStartedAt<NTP_SYNC_TIMEOUT_MS)return;
  lastClockSyncPollAt=now;utcNow=time(nullptr);
  if(utcNow>=MIN_VALID_UTC_EPOCH){
    clockSyncReady=true;clockSyncActive=false;
    Serial.printf("CLOCK_SYNC_OK timezone=UTC epoch=%lld\n",(long long)utcNow);return;
  }
  if(now-clockSyncStartedAt>=NTP_SYNC_TIMEOUT_MS){
    clockSyncActive=false;
    Serial.printf("CLOCK_SYNC_TIMEOUT timeout_ms=%lu retry_after_ms=%lu https_blocked=true queues_retained=true\n",
      (unsigned long)NTP_SYNC_TIMEOUT_MS,(unsigned long)NTP_SYNC_RETRY_MS);
  }
}
static void initWifi(){
  WiFi.mode(WIFI_STA);WiFi.setSleep(false);
  if(String(WIFI_SSID)!="SET_WIFI_SSID"&&strlen(WIFI_SSID)){
    WiFi.begin(WIFI_SSID,WIFI_PASSWORD);uint32_t start=millis();
    while(WiFi.status()!=WL_CONNECTED&&millis()-start<WIFI_TIMEOUT_MS)delay(100);
  }
  if(WiFi.status()==WL_CONNECTED){
    wifiReady=true;meshChannel=WiFi.channel();
    Serial.printf("WIFI_CONNECTED channel=%u\n",meshChannel);
    Serial.printf("GATEWAY_CHANNEL_SET channel=%u source=associated_ap\n",meshChannel);
  }else{
    wifiReady=false;uint8_t radioChannel=0;wifi_second_chan_t second;
    if(esp_wifi_get_channel(&radioChannel,&second)==ESP_OK&&radioChannel>=1&&radioChannel<=13)meshChannel=radioChannel;
    else meshChannel=MESH_BOOT_CHANNEL;
    Serial.printf("CLOUD_OUTAGE reason=wifi_unavailable_at_start; mesh_channel=%u; beacons_wait_for_ap; queued_uploads_retained\n",meshChannel);
  }
}
static void uploadTask(void*){
  for(;;){
    serviceClockSync();
    uint32_t now=millis();
    const bool sensorDue=now-lastPublish>=API_PUBLISH_INTERVAL;
    const bool routeDue=now-lastRoutePublish>=API_PUBLISH_INTERVAL;
    if(sensorDue||routeDue){
      if(sensorDue)lastPublish=now;
      if(routeDue)lastRoutePublish=now;
      if(WiFi.status()==WL_CONNECTED&&!clockSyncReady){
        if(queuedTelemetry()||queuedRoutingEvents())
          Serial.printf("UPLOAD_DEFERRED reason=clock_unsynced sensor_queue=%u route_queue=%u; retained=true\n",queuedTelemetry(),queuedRoutingEvents());
      }else{
        bool sensorBlocked=false,routeBlocked=false;
        for(;;){
        bool progressed=false;MeshPacket p{};
        if(sensorDue&&!sensorBlocked&&peekTelemetry(p)){
          if(WiFi.status()!=WL_CONNECTED){
            Serial.printf("API_OFFLINE sensor_queue=%u route_queue=%u; retained\n",queuedTelemetry(),queuedRoutingEvents());sensorBlocked=true;
          }else{
            __atomic_store_n(&apiUploadActive,true,__ATOMIC_RELAXED);
            bool uploadSucceeded=publishOne(p);
            __atomic_store_n(&apiUploadActive,false,__ATOMIC_RELAXED);
            if(uploadSucceeded){
            __atomic_add_fetch(&apiSuccessEvents,1,__ATOMIC_RELAXED);
            removePublishedTelemetry(p);__atomic_add_fetch(&published,1,__ATOMIC_RELAXED);progressed=true;
            Serial.printf("API_PUBLISHED seq=%lu queued=%u\n",(unsigned long)p.sequence,queuedTelemetry());
            }else{
            __atomic_add_fetch(&apiFailureEvents,1,__ATOMIC_RELAXED);
            uint32_t failures=__atomic_add_fetch(&apiFailures,1,__ATOMIC_RELAXED);sensorBlocked=true;
            Serial.printf("API_RETRY seq=%lu failures=%lu queued=%u; retained_until_next_5s_cycle\n",(unsigned long)p.sequence,(unsigned long)failures,queuedTelemetry());
            }
          }
        }
        if(routeDue&&!routeBlocked&&peekRoutingEvent(p)){
          if(WiFi.status()!=WL_CONNECTED){
            Serial.printf("ROUTING_API_OFFLINE queued=%u; retained\n",queuedRoutingEvents());routeBlocked=true;
          }else{
            __atomic_store_n(&apiUploadActive,true,__ATOMIC_RELAXED);
            bool uploadSucceeded=publishRoutingEvent(p);
            __atomic_store_n(&apiUploadActive,false,__ATOMIC_RELAXED);
            if(uploadSucceeded){
            __atomic_add_fetch(&apiSuccessEvents,1,__ATOMIC_RELAXED);
            removePublishedRoutingEvent(p);__atomic_add_fetch(&routePublished,1,__ATOMIC_RELAXED);progressed=true;
            Serial.printf("ROUTING_EVENT_PUBLISHED seq=%lu queued=%u\n",(unsigned long)p.sequence,queuedRoutingEvents());
            }else{
            __atomic_add_fetch(&apiFailureEvents,1,__ATOMIC_RELAXED);
            uint32_t failures=__atomic_add_fetch(&apiFailures,1,__ATOMIC_RELAXED);routeBlocked=true;
            Serial.printf("ROUTING_EVENT_RETRY seq=%lu failures=%lu queued=%u; retained_until_next_5s_cycle\n",(unsigned long)p.sequence,(unsigned long)failures,queuedRoutingEvents());
            }
          }
        }
          if(!progressed)break;
        }
      }
    }
    vTaskDelay(pdMS_TO_TICKS(10));
  }
}
void setup(){
  Serial.begin(115200);
  pinMode(LED_RED,OUTPUT);pinMode(LED_YELLOW,OUTPUT);pinMode(LED_GREEN,OUTPUT);
  digitalWrite(LED_RED,LOW);digitalWrite(LED_YELLOW,LOW);digitalWrite(LED_GREEN,LOW);
  WiFi.mode(WIFI_STA);rxQueue=xQueueCreate(RX_QUEUE_SIZE,sizeof(RxFrame));
  if(!rxQueue){Serial.println("ERROR rx_queue");while(true)delay(1000);}
  initWifi();if(esp_now_init()!=ESP_OK){Serial.println("ERROR esp_now_init");while(true)delay(1000);}
  addPeer(BROADCAST_MAC);esp_now_register_recv_cb(receiveCallback);
  espNowReady=true;lastPublish=millis()-API_PUBLISH_INTERVAL;lastRoutePublish=millis()-API_PUBLISH_INTERVAL;
  // Lower priority than Arduino loop task; HTTP/TLS cannot starve its ESP-NOW queue drain.
  uploadTaskReady=xTaskCreatePinnedToCore(uploadTask,"p12_upload",UPLOAD_TASK_STACK_BYTES,nullptr,0,nullptr,1)==pdPASS;
  if(!uploadTaskReady)
    Serial.println("CLOUD_OUTAGE reason=upload_task_create_failed; mesh_receiving_without_api_upload");
  Serial.printf("READY %s channel=%u wifi=%s cloud=%s api=%s\n",NODE_NAME,meshChannel,wifiReady?"online":"offline",(wifiReady&&uploadTaskReady)?"upload_ready":"offline",API_URL);
}
void loop(){
  serviceWiFi();serviceRx();serviceChannelSync();
  uint32_t successes=__atomic_load_n(&apiSuccessEvents,__ATOMIC_RELAXED);
  uint32_t failures=__atomic_load_n(&apiFailureEvents,__ATOMIC_RELAXED);
  uint32_t overflows=readRxQueueOverflows();
  uint32_t rejected=__atomic_load_n(&backpressureRejected,__ATOMIC_RELAXED);
  if(successes!=observedApiSuccessEvents){observedApiSuccessEvents=successes;requestStatusLED(LED_COLOR_GREEN,LED_SUCCESS_HOLD_MS);}
  if(failures!=observedApiFailureEvents){observedApiFailureEvents=failures;requestStatusLED(LED_COLOR_RED,LED_ERROR_HOLD_MS);}
  if(overflows!=observedRxQueueOverflows){observedRxQueueOverflows=overflows;requestStatusLED(LED_COLOR_RED,LED_ERROR_HOLD_MS);}
  if(rejected!=observedBackpressureRejected){observedBackpressureRejected=rejected;requestStatusLED(LED_COLOR_RED,LED_ERROR_HOLD_MS);}
  serviceStatusLED(!wifiReady,__atomic_load_n(&apiUploadActive,__ATOMIC_RELAXED)||uxQueueMessagesWaiting(rxQueue)>0);
  if(millis()-lastStats>=10000){lastStats=millis();Serial.printf("GATEWAY_STATUS node=4 wifi=%s cloud=%s channel=%u espnow=%s api_ok=%lu route_api_ok=%lu api_fail=%lu sensor_queue=%u route_queue=%u rx=%lu rx_queue_overflow=%lu dup=%lu backpressure_rejected=%lu latest_src=%u latest_seq=%lu rssi=%d\n",
    wifiReady?"online":"offline",(wifiReady&&uploadTaskReady)?"upload_ready":"offline",WiFi.channel(),espNowReady?"ready":"error",(unsigned long)__atomic_load_n(&published,__ATOMIC_RELAXED),(unsigned long)__atomic_load_n(&routePublished,__ATOMIC_RELAXED),(unsigned long)__atomic_load_n(&apiFailures,__ATOMIC_RELAXED),queuedTelemetry(),queuedRoutingEvents(),(unsigned long)received,(unsigned long)readRxQueueOverflows(),(unsigned long)duplicates,(unsigned long)__atomic_load_n(&backpressureRejected,__ATOMIC_RELAXED),
    latest.source_id,(unsigned long)latest.sequence,currentRssi);}
  delay(1);
}
