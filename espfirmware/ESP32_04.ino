static constexpr uint8_t BROADCAST_MAC[6] = {0xFF,0xFF,0xFF,0xFF,0xFF,0xFF};
static bool addPeer(const uint8_t *mac) {
  if (esp_now_is_peer_exist(mac)) return true;
  esp_now_peer_info_t peer{};
  memcpy(peer.peer_addr, mac, 6);
  peer.channel = 0;
  peer.ifidx = WIFI_IF_STA;
  peer.encrypt = false;
  return esp_now_add_peer(&peer) == ESP_OK;
}
static bool sendBroadcast(const MeshPacket &packet) {
  return esp_now_send(BROADCAST_MAC, reinterpret_cast<const uint8_t *>(&packet), sizeof(packet)) == ESP_OK;
}
static void copyText(char *dst, size_t size, const char *src) {
  strncpy(dst, src, size - 1);
  dst[size - 1] = '\0';
}

static bool isChannelSyncType(uint8_t type) { return type>=PACKET_GATEWAY_BEACON&&type<=PACKET_CHANNEL_CHANGE_NOTICE; }
static bool validChannelSyncPacket(const MeshPacket &p) {
  return p.version==PROTOCOL_VERSION&&isChannelSyncType(p.type)&&
    !strncmp(p.project_id,PROJECT_ID,sizeof(p.project_id))&&
    !strncmp(p.network_id,NETWORK_ID,sizeof(p.network_id))&&
    !strncmp(p.experiment_id,EXPERIMENT_ID,sizeof(p.experiment_id))&&
    p.routing_algorithm==SYNC_MARKER&&p.feature_valid==0xA5&&p.predicted_class==-42&&
    p.route_change==SYNC_ROUTE_MARKER&&p.route_change_reason==0x51&&p.hop_count==0x5A&&p.hop_limit==0xA5&&
    p.source_packets_sent==SYNC_MAGIC&&p.next_hop_id>=1&&p.next_hop_id<=13&&p.selected_next_hop_id==p.next_hop_id;
}
static MeshPacket makeChannelSyncPacket(uint8_t type,uint8_t source,uint8_t destination,uint8_t channel,uint32_t sequence,uint32_t uptime) {
  MeshPacket p{};p.version=PROTOCOL_VERSION;p.type=type;copyText(p.project_id,sizeof(p.project_id),PROJECT_ID);
  copyText(p.network_id,sizeof(p.network_id),NETWORK_ID);copyText(p.experiment_id,sizeof(p.experiment_id),EXPERIMENT_ID);
  p.source_id=source;p.destination_id=destination;p.next_hop_id=channel;p.selected_next_hop_id=channel;
  p.routing_algorithm=SYNC_MARKER;p.sequence=sequence;p.source_uptime_ms=uptime;p.hop_count=0x5A;p.hop_limit=0xA5;
  p.feature_valid=0xA5;p.predicted_class=-42;p.route_change=SYNC_ROUTE_MARKER;p.route_change_reason=0x51;p.source_packets_sent=SYNC_MAGIC;return p;
}
static bool processChannelSyncFrame(const RxFrame &frame) {
  const MeshPacket &p=frame.packet;
  if(!isChannelSyncType(p.type))return false;
  if(!wifiReady||!validChannelSyncPacket(p)||p.next_hop_id!=meshChannel)return true;
  uint8_t slot=p.source_id;
  if(p.type==PACKET_CHANNEL_SYNC_REQUEST&&slot>=1&&slot<=3&&p.destination_id==NODE_ID) {
    channelSyncRequestSequence[slot]=p.sequence;channelSyncRequestUptime[slot]=p.source_uptime_ms;
    memcpy(channelSyncMac[slot],frame.mac,6);
    MeshPacket response=makeChannelSyncPacket(PACKET_CHANNEL_SYNC_RESPONSE,NODE_ID,slot,meshChannel,p.sequence,p.source_uptime_ms);
    if(addPeer(frame.mac))esp_now_send(frame.mac,reinterpret_cast<const uint8_t*>(&response),sizeof(response));
    return true;
  }
  if(p.type==PACKET_CHANNEL_SYNC_ACK&&slot>=1&&slot<=3&&p.destination_id==NODE_ID&&
     p.sequence==channelSyncRequestSequence[slot]&&p.source_uptime_ms==channelSyncRequestUptime[slot]&&
     memcmp(frame.mac,channelSyncMac[slot],6)==0) {
    bool fresh=!channelSyncAckAt[slot]||millis()-channelSyncAckAt[slot]>CHANNEL_NODE_LEASE_MS;
    channelSyncAckAt[slot]=millis();
    if(fresh)Serial.printf("NODE_CHANNEL_SYNC node=%u channel=%u result=success\n",slot,meshChannel);
    return true;
  }
  return true;
}
static void serviceChannelSync() {
  if(!wifiReady||WiFi.status()!=WL_CONNECTED)return;
  uint32_t now=millis();
  if(channelNoticePending) {
    MeshPacket notice=makeChannelSyncPacket(PACKET_CHANNEL_CHANGE_NOTICE,NODE_ID,255,meshChannel,++channelBeaconSequence,now);
    sendBroadcast(notice);channelNoticePending=false;
  }
  if(now-lastChannelBeaconAt>=CHANNEL_BEACON_INTERVAL_MS) {
    lastChannelBeaconAt=now;
    MeshPacket beacon=makeChannelSyncPacket(PACKET_GATEWAY_BEACON,NODE_ID,255,meshChannel,++channelBeaconSequence,now);
    sendBroadcast(beacon);
  }
  uint8_t synchronized=0;for(uint8_t id=1;id<=3;++id)if(channelSyncAckAt[id]&&now-channelSyncAckAt[id]<=CHANNEL_NODE_LEASE_MS)++synchronized;
  if(synchronized==3&&!meshReadyReported){meshReadyReported=true;Serial.printf("MESH_READY channel=%u synchronized_nodes=3\n",meshChannel);}
  if(synchronized<3)meshReadyReported=false;
}

